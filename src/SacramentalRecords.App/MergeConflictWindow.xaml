<Window x:Class="SacramentalRecords.App.MergeConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge Conflicts" Icon="/assets/sr.ico" Height="600" Width="900" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <Thickness x:Key="ContentMargin">24</Thickness>
        <Thickness x:Key="HeaderMargin">0,0,0,20</Thickness>
        <Thickness x:Key="ConflictItemMargin">0,0,0,16</Thickness>
    </Window.Resources>
    
    <Grid Margin="{DynamicResource ContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{DynamicResource HeaderMargin}">
            <TextBlock Text="MERGE CONFLICTS" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" />
            <TextBlock Text="Resolve conflicting data" Style="{StaticResource DisplayText}" FontSize="24" FontWeight="Bold" Margin="0,8,0,8" />
            <TextBlock Text="Select the preferred value for each conflicting field below." Foreground="{StaticResource MutedBrush}" FontSize="14" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ConflictsPanel" Margin="0,0,16,0" />
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Width="120" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
                <Button x:Name="MergeButton" Content="Merge" Width="120" Margin="12,0,0,0" Click="Merge_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
