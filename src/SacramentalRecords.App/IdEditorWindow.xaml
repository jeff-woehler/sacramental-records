<Window x:Class="SacramentalRecords.App.IdEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit ID" Icon="/assets/sr.ico" Height="375" Width="500" MinHeight="200" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Thickness x:Key="ContentMargin">24</Thickness>
        <Thickness x:Key="HeaderMargin">0,0,0,20</Thickness>
        <Thickness x:Key="FieldMargin">0,0,0,16</Thickness>
    </Window.Resources>
    
    <Grid Margin="{DynamicResource ContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{DynamicResource HeaderMargin}">
            <TextBlock Text="EDIT ID" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" />
            <TextBlock x:Name="TitleText" Style="{StaticResource DisplayText}" FontSize="24" FontWeight="Bold" Margin="0,8,0,8" />
            <TextBlock x:Name="DescriptionText" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="{DynamicResource FieldMargin}">
            <StackPanel>
                <TextBlock Text="ID Value" Style="{StaticResource CardLabel}" />
                <TextBox x:Name="IdValueBox" Height="40" Padding="12,8" FontSize="14" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Width="100" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" ToolTip="Cancel (Esc)" />
                <Button x:Name="SaveButton" Content="Save" Width="100" Margin="12,0,0,0" Click="Save_Click" ToolTip="Save (Enter)" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
