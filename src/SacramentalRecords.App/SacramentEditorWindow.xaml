<Window x:Class="SacramentalRecords.App.SacramentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sacrament" Width="800" Height="800" MinHeight="700" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style TargetType="ComboBoxItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style TargetType="DatePickerTextBox">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <DataTemplate x:Key="SacramentTypeItemTemplate">
      <TextBlock Text="{Binding Content}"
                 FontFamily="Segoe UI"
                 FontSize="17"
                 Foreground="{StaticResource InkBrush}"
                 VerticalAlignment="Center"
                 Padding="2,0" />
    </DataTemplate>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="SACRAMENTAL REGISTRY" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
      <TextBlock Grid.Row="1" x:Name="HeadingText" Style="{StaticResource DisplayText}" FontSize="28" FontWeight="Bold" Margin="0,5,0,24"/>
      <Grid Grid.Row="2" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Type *" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
        <ComboBox x:Name="TypeBox" Grid.Column="1" Margin="4" Height="40" Padding="8,0" FontFamily="Segoe UI" FontSize="17" Foreground="{StaticResource InkBrush}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ItemTemplate="{StaticResource SacramentTypeItemTemplate}"/>
        <TextBlock Grid.Column="3" Text="Date" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
        <DatePicker x:Name="DatePicker" Grid.Column="4" Height="40" FontSize="15" Foreground="{StaticResource InkBrush}" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"/>
      </Grid>
      <Grid Grid.Row="3" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="NameLabel" Text="Name" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBox x:Name="NameBox" Grid.Column="1" Margin="4"/>
        <TextBlock Grid.Column="3" Text="Performed at" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBox x:Name="PlaceBox" Grid.Column="4" Margin="4"/>
      </Grid>
      <Grid Grid.Row="4" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Minister" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBox x:Name="MinisterBox" Grid.Column="1" Margin="4"/>
        <TextBlock Grid.Column="3" Text="Register Location" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
        <Grid Grid.Column="4" Margin="0,0,16,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="Volume" Grid.Column="0" FontSize="11" FontWeight="SemiBold" Margin="4,0,4,2"/>
          <TextBlock Text="Page" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Margin="4,0,4,2"/>
          <TextBlock Text="Item" Grid.Column="2" FontSize="11" FontWeight="SemiBold" Margin="4,0,4,2"/>
          <TextBox x:Name="VolumeBox" Grid.Row="1" Grid.Column="0" Margin="4" ToolTip="Volume"/>
          <TextBox x:Name="PageBox" Grid.Row="1" Grid.Column="1" Margin="4" ToolTip="Page"/>
          <TextBox x:Name="ItemBox" Grid.Row="1" Grid.Column="2" Margin="4" ToolTip="Number"/>
        </Grid>
      </Grid>
      <Grid Grid.Row="5" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Father" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBox x:Name="FatherBox" Grid.Column="1" Margin="4"/>
        <TextBlock Grid.Column="3" Text="Mother" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBox x:Name="MotherBox" Grid.Column="4" Margin="4"/>
      </Grid>
      <Grid Grid.Row="6" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="SponsorOneLabel" Text="Sponsor 1" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBox x:Name="SponsorOneBox" Grid.Column="1" Margin="4"/>
        <TextBlock x:Name="SponsorTwoLabel" Grid.Column="3" Text="Sponsor 2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
        <Grid Grid.Column="4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="SponsorTwoBox" Margin="4"/>
          <CheckBox x:Name="SponsorTwoWitnessBox" Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="This sponsor is a Christian witness."/>
        </Grid>
      </Grid>
      <Grid Grid.Row="7" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Proxy 1" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBox x:Name="ProxyOneBox" Grid.Column="1" Margin="4"/>
        <TextBlock Grid.Column="3" Text="Proxy 2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBox x:Name="ProxyTwoBox" Grid.Column="4" Margin="4"/>
      </Grid>
      <StackPanel Grid.Row="8">
        <TextBlock Text="Details" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="DetailsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="75" Margin="4"/>
        <TextBlock Text="Canonical notations" FontWeight="SemiBold" Margin="0,14,0,5"/><TextBox x:Name="NotationsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="75" Margin="4"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
          <Button Content="Cancel" IsCancel="True" Width="100" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" ToolTip="Cancel (Esc)"/><Button Content="Save sacrament" IsDefault="True" Width="140" Click="Save_Click" ToolTip="Save sacrament (Enter or Ctrl+S)"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>
