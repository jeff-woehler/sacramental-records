<UserControl x:Class="SacramentalRecords.App.PartialDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="40">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    
    <!-- Text input that allows partial dates or full dates -->
    <TextBox x:Name="DateTextBox" 
             Grid.Column="0"
             Margin="0"
             Padding="8,0"
             VerticalContentAlignment="Center"
             FontSize="15"
             PreviewTextInput="DateTextBox_PreviewTextInput"
             LostFocus="DateTextBox_LostFocus"
             ToolTip="Enter date as: YYYY, YYYY-MM, or YYYY-MM-DD"/>
    
    <!-- Calendar picker button for full date selection -->
    <Button x:Name="PickerButton"
            Grid.Column="1"
            Margin="4,2,4,2"
            Padding="6,0"
            Width="Auto"
            Height="36"
            Background="#F0F0F0"
            BorderThickness="1"
            BorderBrush="#D0D0D0"
            Foreground="#333"
            Click="PickerButton_Click"
            ToolTip="Open calendar to select date"
            VerticalAlignment="Center"
            Content="📅"
            FontSize="18"
            Cursor="Hand"/>
  </Grid>
</UserControl>
