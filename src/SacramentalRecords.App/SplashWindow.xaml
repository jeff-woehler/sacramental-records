<Window x:Class="SacramentalRecords.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sacramental Records"
        Width="440" Height="330"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/assets/sr.ico">
  <Border Margin="2" Background="{StaticResource PageBrush}" CornerRadius="34">
    <Border Margin="10" Padding="32" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="24">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image Source="/assets/sr.png" Width="116" Height="116" Stretch="Uniform" />
      <TextBlock Text="Sacramental Records" Style="{StaticResource DisplayText}"
                 FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,5" />
      <TextBlock Text="Parish Registry" Foreground="{StaticResource MutedBrush}"
                 FontSize="15" HorizontalAlignment="Center" />
      <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}"
                 FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0" />
    </StackPanel>
    </Border>
  </Border>
</Window>
