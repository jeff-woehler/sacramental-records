<Window x:Class="SacramentalRecords.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SacramentalRecords.App"
        Title="Sacramental Records" Icon="/assets/sr.ico" Height="680" Width="1100" MinHeight="520" MinWidth="850"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <app:StatusDisplayConverter x:Key="StatusDisplayConverter" />
  </Window.Resources>
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="PARISH REGISTRY" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" />
        <TextBlock Text="Sacramental Records" Style="{StaticResource DisplayText}" FontSize="38" FontWeight="Bold" Margin="0,5,0,2" />
        <TextBlock Text="A clear, trusted place for parish records" Foreground="{StaticResource MutedBrush}" FontSize="16" />
      </StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="14,9">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
            <TextBlock x:Name="ModeText" Text="No data source selected" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="14" />
          </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Admin" Width="100" Style="{StaticResource SecondaryButton}" Click="Admin_Click" ToolTip="Open administration settings." />
            <Button Content="Open" Width="100" Margin="10,0,0,0" Click="LocalAdmin_Click" ToolTip="Open the synchronized SQLite package (Ctrl+O)." />
            <Button x:Name="SaveButton" Content="Save" Width="100" Margin="10,0,0,0" Click="Publish_Click" ToolTip="Package local SQLite data and publish it to OneDrive." />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" Grid.Column="0" Height="46" FontSize="15" VerticalContentAlignment="Center" ToolTip="Search by family or given name (Ctrl+F)" />
        <Button Grid.Column="1" Content="Search" Width="100" Margin="10,0,0,0" Click="Search_Click" ToolTip="Search (Enter)" />
                <Button x:Name="AddButton" Grid.Column="2" Content="Add" Width="100" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Click="AddPerson_Click" ToolTip="Add person (Ctrl+N)" />
        <Button x:Name="EditButton" Grid.Column="3" Content="Edit" Width="100" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Click="OpenPerson_Click" ToolTip="Open selected person (Enter or double-click)" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="0">
      <Grid Margin="18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,0,29,8" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.35*" />
              <ColumnDefinition Width="1.35*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="FAMILY NAME" Style="{StaticResource CardLabel}" />
            <TextBlock Grid.Column="1" Text="GIVEN NAME" Style="{StaticResource CardLabel}" />
            <TextBlock Grid.Column="2" Text="BIRTH DATE" Style="{StaticResource CardLabel}" />
            <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource CardLabel}" />
          </Grid>
        </Border>
        <ListBox x:Name="PeopleGrid"
                 Grid.Row="1"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 MouseDoubleClick="PeopleGrid_MouseDoubleClick"
                 KeyDown="PeopleGrid_KeyDown">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,6" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="CardBorder"
                            Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,7">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource AccentLightBrush}" />
                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.35*" />
                  <ColumnDefinition Width="1.35*" />
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding FamilyName, TargetNullValue=—}" FontSize="15" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding GivenName, TargetNullValue=—}" FontSize="15" Margin="0,0,12,0" />
                <TextBlock Grid.Column="2" Text="{Binding BirthDate, StringFormat={}{0:d}, TargetNullValue=—}" FontSize="15" Margin="0,0,12,0" />
                <TextBlock Grid.Column="3" Text="{Binding Status, Converter={StaticResource StatusDisplayConverter}}" FontSize="15" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StatusBar Grid.Column="0">
        <TextBox x:Name="StatusText"
                 Text="Sign in to begin."
                 IsReadOnly="True"
                 IsTabStop="False"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0"
                 VerticalContentAlignment="Center" />
      </StatusBar>
      <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" FontSize="11" />
      </Border>
    </Grid>
  </Grid>
</Window>
