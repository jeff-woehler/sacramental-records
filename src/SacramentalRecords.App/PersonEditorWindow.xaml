<Window x:Class="SacramentalRecords.App.PersonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Person" Width="760" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="EDIT RECORD" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" />
        <TextBlock Text="Person details" Style="{StaticResource DisplayText}" FontSize="31" FontWeight="Bold" Margin="0,5,0,0" />
        <TextBlock Text="Keep the parish record complete and accurate." Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,4,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="10,7" HorizontalAlignment="Right" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal">
          <StackPanel Margin="0,0,18,0"><TextBlock Text="CHURCH DB" Style="{StaticResource CardLabel}"/><TextBox x:Name="ChurchDbIdBox" FontSize="14" IsReadOnly="True" IsTabStop="False" BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Center"/></StackPanel>
          <StackPanel Margin="0,0,18,0"><TextBlock Text="PDS" Style="{StaticResource CardLabel}"/><TextBox x:Name="PdsIdBox" FontSize="14" IsReadOnly="True" IsTabStop="False" BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Center"/></StackPanel>
          <StackPanel><TextBlock Text="FLOCKNOTE" Style="{StaticResource CardLabel}"/><TextBox x:Name="FlocknoteIdBox" FontSize="14" IsReadOnly="True" IsTabStop="False" BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Center"/></StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="Given name *" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBox x:Name="GivenNameBox" Grid.Column="1" Margin="4"/>
      <TextBlock Grid.Column="3" Text="Middle name" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBox x:Name="MiddleNameBox" Grid.Column="4" Margin="4"/>
    </Grid>
    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="Family name *" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBox x:Name="FamilyNameBox" Grid.Column="1" Margin="4"/>
      <TextBlock Grid.Column="3" Text="Birth date" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><DatePicker x:Name="BirthDatePicker" Grid.Column="4" Margin="4"/>
    </Grid>
    <Grid Grid.Row="3" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="Birth city" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBox x:Name="BirthCityBox" Grid.Column="1" Margin="4"/>
      <TextBlock Grid.Column="3" Text="Status" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><ComboBox x:Name="StatusBox" Grid.Column="4" Margin="4" SelectedValuePath="Tag"><ComboBoxItem Content="Historical" Tag="historical"/><ComboBoxItem Content="Active member" Tag="active_member"/><ComboBoxItem Content="Non-member" Tag="non_member"/></ComboBox>
    </Grid>
    <Border Grid.Row="4" Background="{StaticResource SurfaceMutedBrush}" Padding="12" Margin="0,4,0,0">
      <StackPanel>
        <CheckBox x:Name="CreateBaptismBox" Content="Create a baptism sacrament record after saving" FontWeight="SemiBold" IsChecked="True"/>
        <TextBlock Text="Baptism details can be entered below when needed." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="24,5,0,0"/>
      </StackPanel>
    </Border>
    <GroupBox Grid.Row="5" Header="Baptism details" Margin="0,12,0,0" Padding="8,4">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Baptism date" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><DatePicker x:Name="BaptismDatePicker" Grid.Column="1" Margin="4"/>
        <TextBlock Grid.Column="3" Text="Performed at" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBox x:Name="BaptismChurchBox" Grid.Column="4" Margin="4"/>
      </Grid>
    </GroupBox>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" IsCancel="True" Width="100" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" ToolTip="Cancel (Esc)"/>
      <Button Content="Save record" IsDefault="True" Width="120" Click="Save_Click" ToolTip="Save record (Enter or Ctrl+S)"/>
    </StackPanel>
  </Grid>
</Window>
