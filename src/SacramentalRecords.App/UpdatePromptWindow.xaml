<Window x:Class="SacramentalRecords.App.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available" Width="650" SizeToContent="Height"
        MinWidth="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="SACRAMENTAL RECORDS" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" />
      <TextBlock x:Name="HeadingText" Style="{StaticResource DisplayText}" FontSize="30" FontWeight="Bold" Margin="0,4,0,0" />
    </StackPanel>
    <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" FontSize="15" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="NoButton" Content="Not now" Width="110" Style="{StaticResource SecondaryButton}" Click="No_Click" />
      <Button x:Name="YesButton" Content="Update now" Width="125" Margin="10,0,0,0" Click="Yes_Click" />
    </StackPanel>
  </Grid>
</Window>
