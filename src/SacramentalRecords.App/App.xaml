<Application x:Class="SacramentalRecords.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SacramentalRecords.App"
             Startup="Application_Startup">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      
      <!-- Date precision converter for displaying dates with precision indicators -->
      <local:DatePrecisionConverter x:Key="DatePrecisionConverter"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
