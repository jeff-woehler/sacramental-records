<Window x:Class="SacramentalRecords.App.LockResolutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Package already open" Width="650" SizeToContent="Height"
        MinWidth="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="PACKAGE ACCESS" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" />
      <TextBlock Text="This package is already open" Style="{StaticResource DisplayText}" FontSize="30" FontWeight="Bold" Margin="0,4,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="1">
      <TextBlock Text="Another session may still be using this database package. If the previous session ended unexpectedly, you can remove the stale lock. Otherwise, open a read-only copy." TextWrapping="Wrap" FontSize="15" />
      <TextBlock x:Name="LockOwnerText" TextWrapping="Wrap" FontSize="15" Margin="0,10,0,0" />
      <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
        <TextBlock x:Name="LockPathText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="Cancel" Width="100" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
      <Button Content="Read-only" Width="115" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Click="ReadOnly_Click" />
      <Button Content="Remove lock" Width="125" Margin="10,0,0,0" Click="RemoveLock_Click" />
    </StackPanel>
  </Grid>
</Window>
